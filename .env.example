# TMDB (themoviedb.org → Settings → API). Either the v4 Read Access Token or the v3 key.
TMDB_API_KEY=

# Gemini Flash (aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Supabase (Project Settings → API). Without these, data lives in memory only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (@BotFather → /newbot). Chat ID can also be set on the Preferences page.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Optional: required in the "x-admin-key" header for generate/send/save from the UI
ADMIN_KEY=
