# ─────────────────────────────────────────────────────────────────────────────
# OTT Release Radar — environment variables
# Copy to .env.local for local development; add the same keys in Vercel →
# Project → Settings → Environment Variables. Never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings → API (and Data API)
NEXT_PUBLIC_SUPABASE_URL=             # public: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # public: anon / publishable key (protected by RLS)
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY: service_role / secret key — bypasses RLS

# TMDB — themoviedb.org → Settings → API. Either the v4 "API Read Access Token" (preferred) or the v3 API key.
TMDB_API_KEY=                         # SERVER ONLY

# Google Gemini — aistudio.google.com/app/apikey
GEMINI_API_KEY=                       # SERVER ONLY
GEMINI_MODEL=gemini-flash-latest      # SERVER ONLY: any Gemini Flash model id

# Telegram — message @BotFather, send /newbot, copy the token. Do not set a webhook on this bot.
TELEGRAM_BOT_TOKEN=                   # SERVER ONLY

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate: openssl rand -hex 32
CRON_SECRET=                          # SERVER ONLY, 16+ characters

# Public base URL (used in auth redirects / docs). e.g. https://ott-release-radar.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional: override TMDB provider/network IDs without a code change.
# PROVIDER_MAP_JSON={"hotstar":{"providerIds":[122,2336]}}
